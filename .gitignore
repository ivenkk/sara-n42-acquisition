# Prefer keeping real credentials out of commits.
# Ship config.yaml as a local template (IP prefilled); override passwords locally
# or replace with config.local.yaml if you add one later.
config.local.yaml

# Runtime data
data/
!data/.gitkeep
*.log
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.Python

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
